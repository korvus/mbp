Options -MultiViews
RewriteEngine On

RewriteRule ^si/?$ /sl [R=301,L]
RewriteRule ^si/(.*)$ /sl/$1 [R=301,L]

<Files "passkey.txt">
  Require all denied
</Files>

<FilesMatch "^passkey\.txt$">
  Deny from all
</FilesMatch>

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [QSA,L]
